FLASK_ENV=development
FLASK_PORT=5055
API_SECRET_KEY=ganti_dengan_secret_key_yang_kuat

# Model yang digunakan: VGG-Face, Facenet, Facenet512, ArcFace, DeepFace
FACE_MODEL=Facenet512

# Backend detector: opencv, ssd, dlib, mtcnn, retinaface
DETECTOR_BACKEND=mtcnn

# Threshold confidence (0.0 - 1.0), semakin rendah semakin ketat
FACE_DISTANCE_THRESHOLD=0.40

# Anti-spoof saat REGISTRASI (true/false). Default false: mahasiswa mendaftarkan
# wajahnya sendiri, dan menjalankannya di sini menggandakan beban saat burst.
# Anti-spoof tetap aktif saat VERIFIKASI/voting.
ANTISPOOF_ON_REGISTER=false

# Warmup model saat worker start (true/false). Set false untuk startup cepat di dev.
FACE_WARMUP=true

# Tuning gunicorn (produksi)
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
GUNICORN_BACKLOG=256
